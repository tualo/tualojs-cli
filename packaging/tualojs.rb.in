# typed: strict
# frozen_string_literal: true

# Installs the versioned tualojs release binary for the host platform.
class Tualojs < Formula
  desc "Independent Go-based compiler for Ext JS applications"
  homepage "https://github.com/tualo/tualojs-cli"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/tualo/tualojs-cli/releases/download/v#{version}/tualojs_v#{version}_macos_arm64.tar.gz"
      sha256 "@MACOS_ARM64_SHA256@"
    end
    on_intel do
      url "https://github.com/tualo/tualojs-cli/releases/download/v#{version}/tualojs_v#{version}_macos_amd64.tar.gz"
      sha256 "@MACOS_AMD64_SHA256@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/tualo/tualojs-cli/releases/download/v#{version}/tualojs_v#{version}_linux_arm64.tar.gz"
      sha256 "@LINUX_ARM64_SHA256@"
    end
    on_intel do
      url "https://github.com/tualo/tualojs-cli/releases/download/v#{version}/tualojs_v#{version}_linux_amd64.tar.gz"
      sha256 "@LINUX_AMD64_SHA256@"
    end
  end

  def install
    bin.install "tualojs"
    pkgshare.install "LICENSE", "NOTICE", "README.md", "README.de.md"
  end

  test do
    assert_match "tualojs v#{version}", shell_output("#{bin}/tualojs version")
  end
end
